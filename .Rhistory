Mercado = rep(col_name_2, nrow(tibble))
)
# Bind the new columns to the original tibble
processed_tibble <- bind_cols(tibble, new_df) %>%
select(-c(2:8)) %>%
rename(
Produto = MERCADO,
`Preço médio` = ...9
) %>%
mutate_at(vars(2), as.numeric) %>%
filter(!is.na(`Preço médio`)) %>%
mutate(`Preço médio` = round(`Preço médio`, 2))
return(processed_tibble)
}
processed_list <- map(data_list, process_tibble)
df_Blumenau <- do.call(rbind.data.frame, processed_list)
rownames(df_Blumenau) <- NULL
df_Blumenau <- df_Blumenau %>%
mutate(Mercado = str_to_title(Mercado)) |>
mutate(Mercado = gsub("Komprao", "Komprão", Mercado)) |>
mutate(Produto = gsub("Açucar Refinado", "Açúcar Refinado", Produto))
# CESTA TOTAL (CT) ####
# QUANTIDADES DE CADA PRODUTO, CONFORME DIEESE (REGIÃO 3)
# FONTE: https://www.dieese.org.br/metodologia/metodologiaCestaBasica2016.pdf
quantidade_data <- tibble::tibble(
Produto = c("Arroz tipo 1", "Açúcar Refinado", "Café em pó", "Farinha de Trigo", "Feijão Preto",
"Manteiga", "Óleo de Soja", "Carne", "Pão Francês", "Batata", "Tomate", "Leite", "Banana"),
Quantidade = c(3, 3, 0.6, 1.5, 4.5, 0.75, 0.9, 6.6, 6, 6, 9, 7.5, 1.2)
)
# ESTRUTURA DOS MESES PARA CLASSIFICAÇÃO CRONOLÓGICA
month_order <- c("Janeiro", "Fevereiro", "Março", "Abril", "Maio", "Junho",
"Julho", "Agosto", "Setembro", "Outubro", "Novembro", "Dezembro")
# JUNTAR A BASE COM AS QUANTIDADES ESPECÍFICAS
df_Blumenau_CT <- df_Blumenau %>%
left_join(quantidade_data, by = "Produto") %>%
mutate(Total = `Preço médio` * Quantidade) %>%
mutate(Mês = factor(Mês, levels = month_order)) %>%  # Ensure months are ordered by the custom order
arrange(Ano, Mês)
# CALCULANDO A CESTA DE CADA MERCADO
# RETIRANDO O MENOR E O MAIOR VALOR
# FAZENDO MÉDIA DE CADA MÊS
Blumenau_CT <- df_Blumenau_CT %>%
group_by(Cidade, Ano, Mês, Mercado) %>%
summarise(Cesta = sum(Total), .groups = 'drop') %>%
mutate(
min_value = min(Cesta),
max_value = max(Cesta)
) %>%
filter(Cesta != min_value & Cesta != max_value) %>%
select(-min_value, -max_value) %>%
group_by(Cidade, Ano, Mês) %>%
summarise(Cesta = mean(Cesta), .groups = 'drop')
# ESTRUTURA DOS MESES PARA CLASSIFICAÇÃO CRONOLÓGICA
anos <- unique(Blumenau_CT$Ano)
cidades <- unique(Blumenau_CT$Cidade)
# Definir o mês atual e ano atual
hoje <- Sys.Date()
ano_atual <- year(hoje)
mes_atual <- month(hoje)
anos
cidades
hoje
ano_atual
mes_atual
View(Blumenau_CT)
tail(Blumenau_CT)
# Criar todos os meses possíveis até o mês atual
todos_meses <- expand.grid(Ano = anos, Mês = month_order, Cidade = cidades) %>%
mutate(
Ano = as.numeric(Ano),  # Garantir que o ano seja numérico
Mês_num = match(Mês, month_order)  # Converter o mês para um número (1 a 12)
) %>%
filter(
Ano < ano_atual |
(Ano == ano_atual & Mês_num <= mes_atual)  # Filtrar até o mês atual
) %>%
select(-Mês_num)  # Remover a coluna temporária 'Mês_num'
# Juntar com os dados originais para garantir todos os meses
Blumenau_CT <- todos_meses %>%
left_join(Blumenau_CT %>%
mutate(Ano = as.numeric(Ano), Mês = factor(Mês, levels = month_order)),
by = c("Ano", "Mês", "Cidade")) %>%
mutate(Mês = factor(Mês, levels = month_order)) %>%
arrange(Ano, Mês) %>%
mutate(
`Variação (%)` = ifelse(!is.na(Cesta), (Cesta - lag(Cesta)) / lag(Cesta) * 100, NA),  # Calcular variação apenas se 'Cesta' não for NA
Cesta = round(Cesta, 2),
`Variação (%)` = round(`Variação (%)`, 2),
`Período` = dmy(paste("01", Mês, Ano))  # Criar a data do primeiro dia de cada mês
)
# Visualizar o resultado
print(Blumenau_CT)
# Criar todos os meses possíveis até o mês atual
