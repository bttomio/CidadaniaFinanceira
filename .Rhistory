# Seu vetor de países (OECD usa nomes ou códigos; converta se preciso)
paises_oecd <- c("ALBANIA", "ALGERIA", "ARMENIA", "AZERBAIJAN", "BANGLADESH", "BELARUS", "BENIN", "BHUTAN", "BOLIVIA", "BOSNIA AND HERZEGOVINA", "BOTSWANA", "BRAZIL", "BULGARIA", "BURUNDI", "CABO VERDE", "CAMBODIA", "CAMEROON", "CENTRAL AFRICAN REPUBLIC", "CHAD", "CHILE", "CHINA", "COLOMBIA", "COSTA RICA", "COTE D'IVOIRE", "CROATIA", "DJIBOUTI", "DOMINICAN REPUBLIC", "ECUADOR", "EGYPT", "EL SALVADOR", "EQUATORIAL GUINEA", "ETHIOPIA", "FIJI", "GABON", "GAMBIA", "GEORGIA", "GHANA", "GUATEMALA", "GUINEA", "HAITI", "HONDURAS", "INDIA", "INDONESIA", "IRAN", "IRAQ", "JAMAICA", "JORDAN", "KAZAKHSTAN", "KENYA", "KYRGYZSTAN", "LEBANON", "LESOTHO", "MADAGASCAR", "MALAYSIA", "MALDIVES", "MALI", "MAURITANIA", "MAURITIUS", "MEXICO", "MICRONESIA", "MOLDOVA", "MONGOLIA", "MONTENEGRO", "MOROCCO", "MOZAMBIQUE", "NAMIBIA", "NEPAL", "NICARAGUA", "NIGER", "NORTH MACEDONIA", "PAKISTAN", "PANAMA", "PARAGUAY", "PERU", "PHILIPPINES", "ROMANIA", "RUSSIAN FEDERATION", "RWANDA", "SAMOA", "SENEGAL", "SERBIA", "SIERRA LEONE", "SOLOMON ISLANDS", "SOUTH AFRICA", "SRI LANKA", "SUDAN", "TANZANIA", "THAILAND", "TOGO", "TONGA", "TUNISIA", "TURKEY", "UGANDA", "UKRAINE", "VANUATU", "ZAMBIA", "ZIMBABWE")
# Baixar dados (exemplo para QN: Quarterly National Accounts)
dados_oecd <- get_dataset(dataset = "MEI",
filter = list(COUNTRY = paises_oecd,
SUBJECT = c("NAEXPKD", "NAIMKD", "GDPVOBARSA", "COPC", "LRHUTTTT"),  # Exports, imports, GDP vol, consumer prices, unemployment (ajuste)
FREQUENCY = "A")) %>%  # Annual
mutate(
year = as.numeric(DATE),
# Calcular ABERT: (exports + imports)/GDP * 100 (ajuste colunas)
ABERT = (NAEXPKD + NAIMKD) / GDPVOBARSA * 100,
INF = (COPC / lag(COPC) - 1) * 100,  # Inflação aproximada
RENDA = GDPVOBARSA / POP  # Assumindo POP disponível; senão baixe separado
) %>%
filter(year == 2000) %>%
na.omit()
