# Baixar a série de taxa de câmbio nominal (mensal)
CAMBIO_MENSAL <- ipeadata(code = "PAN12_ERV12", language = "br")
## 3. PREPARAÇÃO E VISUALIZAÇÃO DOS DADOS ####
# Filtrar o período desejado (jul/1994 a jul/2024)
CAMBIO_MENSAL_FILT <- CAMBIO_MENSAL %>%
filter(date >= "1994-07-01" & date <= "2024-07-01")
# Visualizar a série temporal
CAMBIO_MENSAL_FILT %>%
ggplot(aes(x = date, y = value)) +
geom_line(color = "blue") +
labs(title = "Taxa de Câmbio Nominal (R$/US$) - 1994 a 2024",
x = "Data", y = "Valor (R$/US$)") +
theme_minimal()
# Transformar em objeto de série temporal (ts)
CAMBIO_MENSAL_ST <- CAMBIO_MENSAL_FILT %>%
select(value) %>%
ts()
# Plotar a série temporal
ts.plot(CAMBIO_MENSAL_ST, main = "Taxa de Câmbio Nominal (R$/US$)", ylab = "Valor", col = "blue")
### 4.1. Teste com tendência e constante ('trend') ####
# Verificar a significância estatística da tendência ('tt')
CAMBIO_DFA_TEND <- ur.df(y = CAMBIO_MENSAL_ST,
lags = 20,
selectlags = "BIC",
type = "trend")
summary(CAMBIO_DFA_TEND)
## 3. PREPARAÇÃO E VISUALIZAÇÃO DOS DADOS ####
# Filtrar o período desejado (jul/1994 a jul/2024)
CAMBIO_MENSAL_FILT <- CAMBIO_MENSAL %>%
filter(date >= "1994-07-01" & date <= "2023-12-31")
# Visualizar a série temporal
CAMBIO_MENSAL_FILT %>%
ggplot(aes(x = date, y = value)) +
geom_line(color = "blue") +
labs(title = "Taxa de Câmbio Nominal (R$/US$) - 1994 a 2024",
x = "Data", y = "Valor (R$/US$)") +
theme_minimal()
# Transformar em objeto de série temporal (ts)
CAMBIO_MENSAL_ST <- CAMBIO_MENSAL_FILT %>%
select(value) %>%
ts()
# Plotar a série temporal
ts.plot(CAMBIO_MENSAL_ST, main = "Taxa de Câmbio Nominal (R$/US$)", ylab = "Valor", col = "blue")
### 4.1. Teste com tendência e constante ('trend') ####
# Verificar a significância estatística da tendência ('tt')
CAMBIO_DFA_TEND <- ur.df(y = CAMBIO_MENSAL_ST,
lags = 20,
selectlags = "BIC",
type = "trend")
summary(CAMBIO_DFA_TEND)
### 4.2. Teste com constante, sem tendência ('drift') ####
# Verificar a significância estatística da constante ('Intercept')
CAMBIO_DFA_DRIFT <- ur.df(y = CAMBIO_MENSAL_ST,
lags = 20,
selectlags = "BIC",
type = "drift")
summary(CAMBIO_DFA_DRIFT)
### 4.3. Teste sem constante e sem tendência ('none') ####
CAMBIO_DFA_NONE <- ur.df(y = CAMBIO_MENSAL_ST,
lags = 20,
selectlags = "BIC",
type = "none")
summary(CAMBIO_DFA_NONE)
## 5. SOLUÇÃO: APLICAR PRIMEIRA DIFERENÇA ####
# Diferenciar a série para remover a raiz unitária
CAMBIO_MENSAL_ST_1D <- diff(CAMBIO_MENSAL_ST)
# Visualizar a série diferenciada
ts.plot(CAMBIO_MENSAL_ST_1D, main = "Taxa de Câmbio Nominal - Primeira Diferença",
ylab = "Variação", col = "darkgreen")
## 6. TESTE DE RAIZ UNITÁRIA NA SÉRIE DIFERENCIADA ####
### 6.1. Teste com tendência e constante ('trend') ####
CAMBIO_DFA_TEND_1D <- ur.df(y = CAMBIO_MENSAL_ST_1D,
lags = 20,
selectlags = "BIC",
type = "trend")
summary(CAMBIO_DFA_TEND_1D)
### 6.2. Teste com constante, sem tendência ('drift') ####
CAMBIO_DFA_DRIFT_1D <- ur.df(y = CAMBIO_MENSAL_ST_1D,
lags = 20,
selectlags = "BIC",
type = "drift")
summary(CAMBIO_DFA_DRIFT_1D)
## 6. TESTE DE RAIZ UNITÁRIA NA SÉRIE DIFERENCIADA ####
### 6.1. Teste com tendência e constante ('trend') ####
CAMBIO_DFA_TEND_1D <- ur.df(y = CAMBIO_MENSAL_ST_1D,
lags = 20,
selectlags = "BIC",
type = "trend")
summary(CAMBIO_DFA_TEND_1D)
### 6.2. Teste com constante, sem tendência ('drift') ####
CAMBIO_DFA_DRIFT_1D <- ur.df(y = CAMBIO_MENSAL_ST_1D,
lags = 20,
selectlags = "BIC",
type = "drift")
summary(CAMBIO_DFA_DRIFT_1D)
### 6.3. Teste sem constante e sem tendência ('none') ####
CAMBIO_DFA_NONE_1D <- ur.df(y = CAMBIO_MENSAL_ST_1D,
lags = 20,
selectlags = "BIC",
type = "none")
summary(CAMBIO_DFA_NONE_1D)
