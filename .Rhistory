left_join(Blumenau_CT %>%
mutate(Ano = as.character(Ano)),  # Garantir que o 'Ano' em Blumenau_CT seja caractere
by = c("Ano", "Mês", "Cidade")) %>%
mutate(Mês = factor(Mês, levels = month_order)) %>%
