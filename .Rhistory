dados_long <- raw %>%
pivot_longer(
cols = matches(col_ano_regex),
names_to = "ano_col",
values_to = "valor_chr"
) %>%
mutate(
# Extrai ano como inteiro do nome da coluna
ano = as.integer(str_extract(ano_col, "^\\d{4}")),
# Substitui ".." por NA
valor_chr = na_if(valor_chr, ".."),
# Converte para numeric (usa ponto como separador decimal)
valor = suppressWarnings(as.numeric(valor_chr))
)
View(dados_long)
# ─────────────────────────────────────────
# Filtrar pelo ano escolhido
