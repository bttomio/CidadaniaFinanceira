dados_ano <- dados_long %>%
filter(ano == ano_escolhido)
# ─────────────────────────────────────────
# Seleção das séries do modelo e pivotagem para "wide"
# ─────────────────────────────────────────
codigos <- c(
INF   = "FP.CPI.TOTL.ZG",     # inflação (%)
ABERT = "NE.TRD.GNFS.ZS",     # abertura comercial (% PIB)
RENDA = "NY.GDP.PCAP.KD",     # renda per capita (US$ 2015)
AREA  = "AG.SRF.TOTL.K2"      # área (km2)
)
dados_modelo <- dados_ano %>%
filter(`Series Code` %in% codigos) %>%
select(`Country Name`, `Country Code`, `Series Code`, valor) %>%
mutate(var = recode(`Series Code`,
"FP.CPI.TOTL.ZG"  = "INF",
"NE.TRD.GNFS.ZS"  = "ABERT",
"NY.GDP.PCAP.KD"  = "RENDA",
"AG.SRF.TOTL.K2"  = "AREA")) %>%
select(`Country Name`, `Country Code`, var, valor) %>%
pivot_wider(names_from = var, values_from = valor)
View(dados_ano)
library(dplyr)
library(tidyr)
library(stringr)
# Vetor de mapeamento "Series Code" -> nome curto
map_var <- c(
"FP.CPI.TOTL.ZG" = "INF",
"NE.TRD.GNFS.ZS" = "ABERT",
"NY.GDP.PCAP.KD" = "RENDA",
"AG.SRF.TOTL.K2" = "AREA"
)
dados_modelo <- dados_ano %>%
filter(`Series Code` %in% map_var %>% names()) %>%
select(`Country Name`, `Country Code`, `Series Code`, valor) %>%
mutate(
var = dplyr::recode(`Series Code`, !!!map_var, .default = NA_character_)
) %>%
select(`Country Name`, `Country Code`, var, valor) %>%
tidyr::pivot_wider(names_from = var, values_from = valor)
dados_modelo <- dados_ano %>%
filter(`Series Code` %in% c("FP.CPI.TOTL.ZG","NE.TRD.GNFS.ZS","NY.GDP.PCAP.KD","AG.SRF.TOTL.K2")) %>%
select(`Country Name`, `Country Code`, `Series Code`, valor) %>%
mutate(
var = dplyr::case_match(
`Series Code`,
"FP.CPI.TOTL.ZG"  ~ "INF",
"NE.TRD.GNFS.ZS"  ~ "ABERT",
"NY.GDP.PCAP.KD"  ~ "RENDA",
"AG.SRF.TOTL.K2"  ~ "AREA",
.default = NA_character_
)
) %>%
select(`Country Name`, `Country Code`, var, valor) %>%
tidyr::pivot_wider(names_from = var, values_from = valor)
View(dados_modelo)
# ─────────────────────────────────────────
# Remover países com dados faltantes nas variáveis-chave
# ─────────────────────────────────────────
dados <- dados_modelo %>%
filter(!is.na(INF), !is.na(ABERT), !is.na(RENDA), !is.na(AREA))
cat("Ano:", ano_escolhido, "— Países válidos:", nrow(dados), "\n")
# ─────────────────────────────────────────
# Estimação MQ2E (2SLS) com ivreg
# ─────────────────────────────────────────
mq2e <- ivreg(INF ~ ABERT + RENDA | RENDA + AREA, data = dados)
# Resumo com erros-padrão robustos (HC1)
summary_mq2e <- coeftest(mq2e, vcov = sandwich::vcovHC(mq2e, type = "HC1"))
print(summary_mq2e)
# ─────────────────────────────────────────
# Teste Durbin–Wu–Hausman via inclusão de resíduos (robusto)
# ─────────────────────────────────────────
first_stage <- lm(ABERT ~ RENDA + AREA, data = dados)
dados$resid_fs <- residuals(first_stage)
dwh <- lm(INF ~ ABERT + RENDA + resid_fs, data = dados)
dwh_test <- coeftest(dwh, vcov = sandwich::vcovHC(dwh, type = "HC1"))
cat("\nTeste Durbin–Wu–Hausman (coeficiente de resid_fs):\n")
print(dwh_test["resid_fs", , drop = FALSE])
# ─────────────────────────────────────────
# Diagnóstico da força do instrumento (F da 1ª etapa para AREA)
# ─────────────────────────────────────────
# Estatística F aproximada para teste conjunto de instrumentos (RENDA + AREA)
fs_resumo <- summary(first_stage)
cat("\nEstatística F da 1ª etapa (modelo ABERT ~ RENDA + AREA):\n")
print(fs_resumo$fstatistic)
source("~/GitHub/CidadaniaFinanceira/dados.R", echo=TRUE)
rsconnect::deployApp()
