# Pacotes
library(httr)
library(jsonlite)
library(dplyr)
library(tidyr)
library(purrr)
library(stringr)
wb_get_indicator <- function(country = "BRA", indicator, per_page = 20000) {
base <- "http://api.worldbank.org/v2"
url <- sprintf("%s/country/%s/indicator/%s?format=json&per_page=%d",
base, country, indicator, per_page)
resp <- httr::GET(url)
stop_for_status(resp)
dat <- jsonlite::fromJSON(content(resp, "text", encoding = "UTF-8"))
# Elemento 2 do JSON traz as observações
df <- dat[[2]] %>%
transmute(
country = country.value,
indicator = indicator.id,
indicator_name = indicator.value,
year = as.integer(date),
value = as.numeric(value)
) %>%
arrange(year)
return(df)
}
# Exemplo: baixar os 4 indicadores
inds <- c(
ABERT = "NE.TRD.GNFS.ZS",       # Trade (% of GDP)
RENDA = "NY.GDP.PCAP.KD",       # GDP per capita (constant 2015 US$)
INF   = "FP.CPI.TOTL.ZG",       # Inflation, consumer prices (annual %)
AREA  = "AG.SRF.TOTL.K2"        # Surface area (sq. km)
)
lista <- purrr::imap(inds, ~ wb_get_indicator("BRA", .x) %>% mutate(short = .y))
# Empilhar e pivotar em formato wide (anos x variáveis)
wb_wide <- bind_rows(lista) %>%
select(year, short, value) %>%
tidyr::pivot_wider(names_from = short, values_from = value) %>%
arrange(year)
lista <- purrr::imap(inds, ~ wb_get_indicator("BRA", .x) %>% mutate(short = .y))
