library(readxl)
library(dplyr)
library(tidyr)
library(stringr)
library(ivreg)
library(lmtest)
library(sandwich)
# ─────────────────────────────────────────
# Parâmetros: arquivo e ano
# ─────────────────────────────────────────
ano_escolhido   <- 1998                # <- mude para o ano desejado (ex.: 1995, 1998 etc.)
# ─────────────────────────────────────────
# Leitura do Excel
# ─────────────────────────────────────────
# Espera colunas como: Country Name, Country Code, Series Name, Series Code, 1994 [YR1994], 1995 [YR1995], ...
raw <- Avaliação_4_Dados
# ─────────────────────────────────────────
# Tratamento de anos e valores
# ─────────────────────────────────────────
# 1) Colunas de ano seguem padrão "1998 [YR1998]"; vamos transformar para long:
col_ano_regex <- "^\\d{4} \\[YR\\d{4}\\]$"
dados_long <- raw %>%
pivot_longer(
cols = matches(col_ano_regex),
names_to = "ano_col",
values_to = "valor"
) %>%
mutate(
# Extrai ano numérico do nome da coluna
ano = as.integer(str_extract(ano_col, "^\\d{4}")),
# Substitui ".." por NA e vírgula por ponto, depois converte para numeric
valor = na_if(valor, ".."),
valor = ifelse(is.character(valor), str_replace(valor, ",", "."), valor),
valor = suppressWarnings(as.numeric(valor))
)
# ─────────────────────────────────────────
# Filtro pelo ano escolhido
# ─────────────────────────────────────────
dados_ano <- dados_long %>%
filter(ano == ano_escolhido)
# ─────────────────────────────────────────
# Seleção das séries do modelo e pivotagem para "wide"
# ─────────────────────────────────────────
codigos <- c(
INF   = "FP.CPI.TOTL.ZG",     # inflação (%)
ABERT = "NE.TRD.GNFS.ZS",     # abertura comercial (% PIB)
RENDA = "NY.GDP.PCAP.KD",     # renda per capita (US$ constantes 2015)
AREA  = "AG.SRF.TOTL.K2"      # área (km2)
)
dados_modelo <- dados_ano %>%
filter(`Series Code` %in% codigos) %>%
select(`Country Name`, `Country Code`, `Series Code`, valor) %>%
mutate(var = recode(`Series Code`,
"FP.CPI.TOTL.ZG"  = "INF",
"NE.TRD.GNFS.ZS"  = "ABERT",
"NY.GDP.PCAP.KD"  = "RENDA",
"AG.SRF.TOTL.K2"  = "AREA")) %>%
select(`Country Name`, `Country Code`, var, valor) %>%
pivot_wider(names_from = var, values_from = valor)
View(dados_ano)
View(Avaliação_4_Dados)
View(dados_long)
head(Avaliação_4_Dados)
