# Carregar pacotes necessários
library(ggplot2)
library(dplyr)
# Criar data frame com os dados e emojis correspondentes
dados <- data.frame(
Item = c("Café em pó", "Carne", "Manteiga", "Leite", "Feijão preto", "Arroz tipo 1",
"Óleo de soja", "Tomate", "Açúcar refinado", "Farinha de trigo",
"Pão francês", "Banana", "Batata"),
Variacao = c(-7.09, -4.99, -4.17, -3.26, -3.14, -2.01, -1.12, -1.07, 0.22, 1.19, 1.55, 6.97, 17.99),
Emoji = c("☕", "🥩", "🧈", "🥛", "🫘", "🍚",
"🛢️", "🍅", "🍬", "🌾",
"🥖", "🍌", "🥔")
)
# Ordenar os dados da variação mais negativa para a mais positiva
dados <- dados %>% arrange(Variacao)
# Configurar o fator para manter a ordem no gráfico
dados$Item <- factor(dados$Item, levels = dados$Item)
dados$Emoji <- factor(dados$Emoji, levels = dados$Emoji)
# Criar o gráfico de colunas
ggplot(dados, aes(x = Emoji, y = Variacao, fill = Variacao)) +
geom_bar(stat = "identity") +
scale_fill_gradient2(low = "#D73027", mid = "#FFFFBF", high = "#1A9850", midpoint = 0) +
geom_text(aes(label = paste0(Variacao, "%")), vjust = ifelse(dados$Variacao >= 0, -0.5, 1.5), size = 3) +
labs(title = "Variação de Preços da Cesta Básica de Blumenau - Agosto 2025",
x = "Item",
y = "Variação (%)") +
theme_minimal() +
theme(
axis.text.x = element_text(size = 14), # Aumentar tamanho dos emojis
plot.title = element_text(hjust = 0.5, size = 14, face = "bold"),
axis.title = element_text(size = 12),
panel.grid.major.x = element_blank()
)
source("~/.active-rstudio-document", echo=TRUE)
source("~/.active-rstudio-document", echo=TRUE)
# Criar o gráfico de colunas
ggplot(dados, aes(x = Item, y = Variacao, fill = Variacao)) +
geom_bar(stat = "identity") +
scale_fill_gradient2(low = "#FF0000", mid = "#FFFFFF", high = "#0000FF",
limits = c(-limite, limite), midpoint = 0) +
geom_text(aes(label = paste0(Variacao, "%")), vjust = ifelse(dados$Variacao >= 0, -0.5, 1.5), size = 3) +
labs(title = "Variação de Preços da Cesta Básica de Blumenau - Agosto 2025",
x = NULL,
y = "Variação (%)",
caption = "Fonte: Projeto de Extensão Cidadania Financeira da Universidade de Blumenau (FURB). Mais detalhes em furb.br/cidadaniafinanceira.") +
theme_minimal() +
theme(
axis.text.x = element_text(angle = 45, hjust = 1),
plot.title = element_text(hjust = 0.5, size = 14, face = "bold"),
axis.title = element_text(size = 12),
panel.grid.major.x = element_blank(),
legend.position = "none",
plot.caption = element_text(hjust = 0, size = 10)
)
