mutate(
Ano = as.character(Ano),  # Garantir que o 'Ano' seja tratado como caractere
Mês_num = match(Mês, month_order)  # Converter o mês para um número (1 a 12)
) %>%
filter(
Ano < as.character(ano_atual) |
(Ano == as.character(ano_atual) & Mês_num <= mes_atual)  # Filtrar até o mês atual
) %>%
