# HETEROSCEDASTICIDADE ####

# PROBLEMA QUE OCORRE QUANDO A VARIÂNCIA NÃO É A MESMA NA BASE DE DADOS

## TESTE DE BREUSCH-PAGAN

#install.packages("lmtest")

library(lmtest)

bptest(lm(data = cortetransversal, DCF ~ PIB + X + M))

### H0: SEM HETEROSCEDASTICIDADE
#### LOGO, COM p-value < 0.00000000000000022, REJEITA-SE H0 (HÁ HETEROSCEDASTICIDADE)
#### A EXISTÊNCIA DE HETEROSCEDASTICIDADE É UM PROBLEMA, CRIA VIESES NOS RESULTADOS.

## SOLUÇÕES PARA O PROBLEMA
### 1) ESTIMAR O MODELO COM ERRO-PADRÃO ROBUSTO

#install.packages('sandwich')

library(sandwich)

REG1 <- lm(data = cortetransversal, DCF ~ PIB + X + M)

coeftest(REG1, vcov = vcovHC(REG1, "HC1"))   # HC1 fornece os erros padrão de White

### 2) ESTIMAR O MODELO COM MQ GENERALIZADOS (FORÇAR ERROS HOMOSCEDÁSTICOS)

cortetransversal$resi <- REG1$residuals # INSERIR OS RESÍDUOS DE "REG1" NA BASE DE DADOS

VARFUNC_REG1 <- lm(log(resi^2) ~ log(PIB) + log(X) + log(M), data = cortetransversal)

cortetransversal$VARFUNC <- exp(VARFUNC_REG1$fitted.values)

REG1_MQG <- lm(DCF ~ PIB + X + M, weights = 1/sqrt(VARFUNC), data = cortetransversal)

summary(REG1_MQG) # MÍNIMOS QUADRADOS GENERALIZADOS

summary(REG1) # MÍNIMOS QUADRADOS ORDINÁRIOS
