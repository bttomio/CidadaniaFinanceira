# CARREGAR DADOS ####

#install.packages("WDI")

library(WDI) # CHAMAR O PACOTE/A BIBLIOTECA

# OS DADOS DO BANCO MUNDIAL
# WORLD DEVELOPMENT INDICATORS (WDI)

PIB_vars <- WDIsearch('GDP') # GDP = PIB

# NY.GDP.MKTP.CD -  PIB (US$ corrente)

CONSUMO_VARIAVEIS <- WDIsearch('Consumption') # CONSUMO

# NE.CON.TOTL.CD - Despesa de consumo final (US$ corrente)

EXPORT_VARIAVEIS <- WDIsearch('Export') # Exportações

# NE.EXP.GNFS.CD - Exportações de bens e serviços (US$ corrente)

IMPORT_VARIAVEIS <- WDIsearch('Import') # Importações

# NE.IMP.GNFS.CD - Importações de bens e serviços (US$ corrente)

# indicadores = todas as quatro variáveis

indicadores <- c("PIB" = "NY.GDP.MKTP.CD",
                 "DCF" = "NE.CON.TOTL.CD",
                 "X" = 'NE.EXP.GNFS.CD',
                 "M" = "NE.IMP.GNFS.CD")

# CHAMAR A FUNÇÃO PARA COLETAR OS DADOS
# TODOS OS PAÍSES
# 2018

options(scipen = 999) # desativa notação científica

#install.packages("tidyverse")
library(tidyverse) # carregar o pacote {dplyr} e outros

cortetransversal <- WDI(indicadores,
                        country = "all", # "all" == TODOS OS PAÍSES
                        start = 2018,
                        end = 2018) %>% # PASSAR UMA FUNÇÃO (PIPE) PELO {dplyr}
  na.omit() %>% # OMITIR OS DADOS NÃO DISPONÍVEIS (NA = NOT AVAILABLE)
  select(-c(1,3:4)) %>%  # REMOVER AS COLUNAS 1 E 4 (NOME DO PAÍS, ISO3C E ANO)
  remove_rownames %>% 
  column_to_rownames(var="iso2c")

# MATRIZ DE CORRELAÇÃO ####

MC <- cor(cortetransversal) # PRIMEIRO, CALCULA-SE UMA MATRIZ DE CORRELAÇÃO COM O COMANDO BASE 'COR'

#install.packages("corrplot")

library(corrplot)

corrplot(MC, method = 'number')

testRes <- cor.mtest(cortetransversal, conf.level = 0.95)

corrplot(MC, p.mat = testRes$p, method = 'circle', type = 'lower', insig='blank',
         addCoef.col ='black', number.cex = 0.8, order = 'AOE', diag=FALSE)

