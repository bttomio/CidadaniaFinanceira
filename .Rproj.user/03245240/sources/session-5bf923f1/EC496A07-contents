/* CSS for responsive logo */
.logo {
  display: block;         /* Makes the logo behave like a block-level element */
  max-width: 100%;        /* Ensures the logo scales with its container */
  height: auto;           /* Keeps the aspect ratio */
  margin: 0 auto;         /* Horizontally centers the logo */
  margin-bottom: 20px;    /* Adds space below the logo */
}

/* Ensures the logo is vertically and horizontally centered */
.centered-logo-container {
  display: flex;
  justify-content: center;   /* Horizontally centers the content */
  align-items: center;       /* Vertically centers the content */
  height: 100vh;             /* Ensures the container takes full viewport height */
}

/* For mobile devices, make the logo smaller and still centered */
@media (max-width: 767px) {
  .logo {
    max-width: 50%;  /* On small screens, make the logo smaller */
  }
}

@media (max-width: 480px) {
  .logo {
    max-width: 30%;  /* On very small screens, make the logo even smaller */
  }
}

.caixa-cesta {
  border: 2px solid;
  border-radius: 5px;
  padding: 15px;
  margin-bottom: 20px;
  text-align: center;
  font-size: 18px;
  font-weight: bold;
}

.caixa-positiva {
  border-color: #4CAF50; /* Verde */
  background-color: #e8f5e9; /* Verde claro */
  color: #2e7d32; /* Verde escuro */
}

.caixa-negativa {
  border-color: #f44336; /* Vermelho */
  background-color: #ffebee; /* Vermelho claro */
  color: #c62828; /* Vermelho escuro */
}